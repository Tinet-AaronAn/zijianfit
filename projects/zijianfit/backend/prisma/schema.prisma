// Prisma Schema for 自健身 App
// 数据库: SQLite (MVP 阶段)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 用户表 - 用户名密码登录
model User {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String
  openid    String?    @unique
  phone     String?    @unique
  nickname  String?
  avatar    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  plans     Plan[]
  progress  Progress[]

  @@map("users")
}

// 训练计划表
model Plan {
  id              String     @id @default(uuid())
  userId          String?
  name            String
  description     String
  targetAudience  String
  weekNumber      Int
  year            Int
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayPlans        DayPlan[]
  progress        Progress[]

  @@unique([year, weekNumber])
  @@map("plans")
}

// 每日计划表
model DayPlan {
  id            String     @id @default(uuid())
  planId        String
  dayOfWeek     Int        // 1-7 (周一到周日)
  dayName       String     // 周一、周二等
  isRestDay     Boolean    @default(false)
  title         String     // 训练标题
  description   String     @default("")
  totalDuration Int        @default(0) // 总时长(分钟)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  plan          Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises     Exercise[]

  @@unique([planId, dayOfWeek])
  @@map("day_plans")
}

// 动作表
model Exercise {
  id            String   @id @default(uuid())
  dayPlanId     String
  name          String
  type          String   // strength, cardio, hiit, circuit
  sets          Int      @default(1)
  reps          Int      @default(1)
  duration      Int      @default(0) // 持续时间(秒)
  weight        String   @default("")
  restSeconds   Int      @default(0)
  videoUrl      String   @default("")
  videoSource   String   @default("custom") // xiaohongshu, douyin, bilibili, custom
  videoAuthor   String   @default("") // 视频作者
  videoDuration Int      @default(0) // 视频时长(秒)
  description   String   @default("")
  muscleGroup   String   @default("")
  speed         String   @default("")
  heartRate     String   @default("")
  pattern       String   @default("")
  order         Int      // 排序
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dayPlan       DayPlan  @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)

  @@index([dayPlanId, order])
  @@map("exercises")
}

// 训练进度表 - 打卡记录
model Progress {
  id                 String   @id @default(uuid())
  userId             String
  planId             String
  date               DateTime // 训练日期
  completedExercises String?  // JSON: ["exercise-id-1", "exercise-id-2"]
  completedSets      String?  // JSON: {"exercise-id-1": 3, "exercise-id-2": 2}
  isCompleted        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("progress")
}
