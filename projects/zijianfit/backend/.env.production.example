# 生产环境配置模板
# 复制此文件为 .env.production 并填写真实值

# 服务配置
NODE_ENV=production
PORT=3001

# 数据库配置（生产环境建议使用 PostgreSQL）
# DATABASE_URL="postgresql://user:password@localhost:5432/zijianfit?schema=public"
DATABASE_URL="file:./prod.db"

# JWT 配置（请使用强密钥）
JWT_SECRET="your_strong_jwt_secret_here_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# 微信配置（从微信开放平台获取）
WECHAT_APPID="your_wechat_appid_here"
WECHAT_APPSECRET="your_wechat_appsecret_here"

# 日志配置
LOG_LEVEL="info"
LOG_FILE="logs/app.log"

# CORS 配置
CORS_ORIGIN="https://yourdomain.com"

# 速率限制
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
