# Docker Compose 环境变量配置
# 复制此文件为 .env 并修改配置

# ============================================
# 服务配置
# ============================================

# 服务端口（默认 3001）
PORT=3001

# 运行环境（production | development）
NODE_ENV=production

# ============================================
# 数据库配置
# ============================================

# 数据库连接（默认使用 SQLite）
# SQLite: file:/app/data/prod.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=file:/app/data/prod.db

# 数据存储路径（宿主机路径）
DATA_PATH=./data

# ============================================
# 认证配置
# ============================================

# JWT 密钥（必填，至少 32 字符）
# 生成方法: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-this-in-production

# JWT 过期时间（默认 7 天）
# 示例: 1h, 24h, 7d, 30d
JWT_EXPIRES_IN=7d

# ============================================
# 安全配置
# ============================================

# CORS 允许的源（默认允许所有）
# 单个域名: https://example.com
# 多个域名: https://example.com,https://api.example.com
# 允许所有: *
CORS_ORIGIN=*

# ============================================
# 资源配置
# ============================================

# 公共资源路径（视频等静态文件）
PUBLIC_PATH=./public
