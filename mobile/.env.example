# ============================================
# 移动端环境配置
# ============================================
# 复制此文件为 .env 并修改配置

# ============================================
# 后端服务地址
# ============================================

# 开发环境（模拟器）
# Android 模拟器访问宿主机
API_URL_DEV=http://10.0.2.2:3001/api

# iOS 模拟器访问本机
# API_URL_DEV=http://localhost:3001/api

# 生产环境（真机/生产环境）
# 选项1: 使用局域网 IP（开发测试）
# API_URL_PROD=http://192.168.1.100:3001/api

# 选项2: 使用域名 + HTTPS（推荐生产环境）
# API_URL_PROD=https://api.yourdomain.com/api

# ============================================
# 其他配置
# ============================================

# 请求超时时间（毫秒）
API_TIMEOUT=10000

# App 环境（development | production）
APP_ENV=development
